---
# Copy this file to secrets.yml, replace every value, then encrypt it:
# ansible-vault encrypt inventories/example/group_vars/all/secrets.yml
root_passwd: CHANGE_ME
db_passwd: CHANGE_ME
vault_passwd: "{{ db_passwd }}"
redis_password: CHANGE_ME
freva_rest_db_passwd: CHANGE_ME
mongodb_server_db_passwd: "{{ freva_rest_db_passwd }}"
freva_rest_oidc_client_secret: CHANGE_ME
web_oidc_client_secret: "{{ freva_rest_oidc_client_secret }}"
web_redis_username: freva-web
web_redis_password: CHANGE_ME
