---
# Generated by playbooks/compose.yml for local development and release testing.
# This bundle is not a production deployment interface.
name: {{ compose.project_name | to_json }}

services:
  database-server:
    image: {{ compose.images.database | to_json }}
    environment:
      ROOT_PW: {{ compose.secrets.admin_password | to_json }}
      MYSQL_ROOT_PASSWORD: {{ compose.secrets.admin_password | to_json }}
      MYSQL_USER: {{ compose.database.user | to_json }}
      MYSQL_PASSWORD: {{ compose.secrets.database_password | to_json }}
      MYSQL_DATABASE: {{ compose.database.name | to_json }}
      HOST: database-server
      PROJECT: {{ compose.project_name | to_json }}
    ports:
      - {{ (compose.ports.database | string + ':3306') | to_json }}
    volumes:
      - db-data:/data/db:z
      - db-logs:/data/logs:z
    healthcheck:
      test: ["CMD", "healthchecks", "-s", "mysql"]
      interval: 35s
      timeout: 2s
      retries: 3
      start_period: 15s

  vault-server:
    image: {{ compose.images.vault | to_json }}
    environment:
      ROOT_PW: {{ compose.secrets.admin_password | to_json }}
      KEY_FILE: /vault/file/keys
      VAULT_ADD_VAR_DB_USER: {{ compose.database.user | to_json }}
      VAULT_ADD_VAR_DB_PASSWD: {{ compose.secrets.database_password | to_json }}
      VAULT_ADD_VAR_DB_DB: {{ compose.database.name | to_json }}
      VAULT_ADD_VAR_DB_HOST: database-server
      VAULT_ADD_VAR_MONGO_USER: {{ compose.mongodb.user | to_json }}
      VAULT_ADD_VAR_MONGO_PASSWORD: {{ compose.secrets.mongodb_password | to_json }}
      VAULT_ADD_VAR_MONGO_DB: search_stats
      VAULT_ADD_VAR_MONGO_HOST: mongo-server:27017
      VAULT_ADD_VAR_MONGO_URL: {{ ('mongodb://' + compose.mongodb.user + ':' + compose.secrets.mongodb_password + '@mongo-server:27017') | to_json }}
    cap_add:
      - IPC_LOCK
      - SYS_NICE
    ports:
      - {{ (compose.ports.vault | string + ':5002') | to_json }}
    volumes:
      - vault-data:/vault:z
    healthcheck:
      test: ["CMD-SHELL", "/opt/conda/bin/python3 -c 'import urllib.request,json; res=urllib.request.urlopen(\"http://localhost:5002/vault/status\"); assert json.load(res)[\"status\"]==\"unsealed\"'"]
      interval: 35s
      timeout: 2s
      retries: 3
      start_period: 15s

  cache-server:
    image: {{ compose.images.redis | to_json }}
    environment:
      REDIS_USERNAME: {{ compose.redis.user | to_json }}
      REDIS_PASSWORD: {{ compose.secrets.redis_password | to_json }}
    ports:
      - {{ (compose.ports.redis | string + ':6379') | to_json }}
    volumes:
      - cache-data:/data/db:z
      - cache-logs:/data/logs:z
    healthcheck:
      test: ["CMD", "healthchecks", "-s", "redis"]
      interval: 35s
      timeout: 2s
      retries: 3
      start_period: 15s

  mongo-server:
    image: {{ compose.images.mongodb | to_json }}
    environment:
      API_MONGO_USER: {{ compose.mongodb.user | to_json }}
      API_MONGO_PASSWORD: {{ compose.secrets.mongodb_password | to_json }}
      API_MONGO_DB: search_stats
    ports:
      - {{ (compose.ports.mongodb | string + ':27017') | to_json }}
    volumes:
      - mongo-data:/data/db:z
      - mongo-logs:/data/logs:z
    healthcheck:
      test: ["CMD", "healthchecks", "-s", "mongo"]
      interval: 35s
      timeout: 2s
      retries: 3
      start_period: 15s

  search-server:
    image: {{ compose.images.solr | to_json }}
    environment:
      API_SOLR_PORT: "8983"
      API_SOLR_HEAP: {{ compose.solr.heap | to_json }}
    ports:
      - {{ (compose.ports.solr | string + ':8983') | to_json }}
    volumes:
      - solr-data:/data/db:z
      - solr-logs:/data/logs:z
    healthcheck:
      test: ["CMD", "healthchecks", "-s", "solr"]
      interval: 35s
      timeout: 2s
      retries: 3
      start_period: 15s

  freva-rest-server:
    image: {{ compose.images.rest | to_json }}
    environment:
      API_SOLR_CORE: files
      API_PORT: "7777"
      API_PROXY: {{ compose.external_url | to_json }}
      API_OIDC_CLIENT_ID: {{ compose.oidc.client_id | to_json }}
      API_OIDC_DISCOVERY_URL: {{ compose.oidc.discovery_url | to_json }}
      API_OIDC_CLIENT_SECRET: {{ compose.secrets.oidc_client_secret | to_json }}
      API_OIDC_TOKEN_CLAIMS: {{ compose.oidc.token_claims | join(',') | to_json }}
      API_ADMIN_CLAIMS: {{ compose.oidc.admin_claims | join(',') | to_json }}
      API_OIDC_SYSTEMUSER_CLAIM: {{ compose.oidc.system_user_claim | to_json }}
      API_OIDC_TRUSTED_ISSUERS: {{ compose.oidc.trusted_issuers | join(',') | to_json }}
      API_OIDC_SCOPES: {{ compose.oidc.scopes | to_json }}
      API_REDIS_USER: {{ compose.redis.user | to_json }}
      API_REDIS_PASSWORD: {{ compose.secrets.redis_password | to_json }}
      API_REDIS_HOST: redis://cache-server:6379
      API_LOGDIR: /tmp/logs
      API_SOLR_HOST: search-server:8983
      API_MONGO_USER: {{ compose.mongodb.user | to_json }}
      API_MONGO_HOST: mongo-server:27017
      API_MONGO_PASSWORD: {{ compose.secrets.mongodb_password | to_json }}
      API_MONGO_DB: search_stats
      API_SERVICES: {{ compose.rest.services | join(',') | to_json }}
    ports:
      - {{ (compose.ports.rest | string + ':7777') | to_json }}
    volumes:
      - rest-logs:/tmp/logs:z
{% if compose.sss_pipes | default(false) %}
      - /var/lib/sss/pipes:/var/lib/sss/pipes:ro
{% endif %}
    depends_on:
      cache-server:
        condition: service_healthy
      mongo-server:
        condition: service_healthy
      search-server:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "/opt/conda/bin/python3 -c 'import socket; s=socket.create_connection((\"localhost\",7777),2); s.close()'"]
      interval: 35s
      timeout: 2s
      retries: 3
      start_period: 15s

  data-loader-server:
    image: {{ compose.images.data_loader | to_json }}
    command: ["data-loader-worker"]
    environment:
      API_LOGDIR: /tmp/logs
      API_REDIS_USER: {{ compose.redis.user | to_json }}
      API_REDIS_PASSWORD: {{ compose.secrets.redis_password | to_json }}
      API_REDIS_HOST: redis://cache-server:6379
      API_LOGLEVEL: INFO
    volumes:
      - rest-logs:/tmp/logs:z
{% for volume in compose.data_loader_volumes %}
      - {{ (volume.source + ':' + volume.target + ':ro') | to_json }}
{% endfor %}
    depends_on:
      cache-server:
        condition: service_healthy

{% if compose.web.enabled %}
  web-app:
    image: {{ compose.images.web | to_json }}
    command: ["bash", "-c", "./init_django.sh"]
    environment:
      EVALUATION_SYSTEM_CONFIG_FILE: /data/config/evaluation_system.conf
      FREVA_WEB_CONFIG_FILE: /data/config/freva_web.toml
      DJANGO_SUPERUSER_PASSWORD: {{ compose.secrets.admin_password | to_json }}
      ALLOWED_HOSTS: {{ compose.web.allowed_hosts | join(',') | to_json }}
      SCHEDULER_HOST: {{ compose.web.scheduler_hosts | join(',') | to_json }}
      CSRF_TRUSTED_ORIGINS: {{ compose.web.csrf_trusted_origins | join(',') | to_json }}
      FREVA_BIN: /opt/conda/bin
      REDIS_HOST: cache-server
      REDIS_PASSWD: {{ compose.secrets.redis_password | to_json }}
      REDIS_USER: {{ compose.redis.user | to_json }}
      FREVA_REST_URL: http://freva-rest-server:7777
      CHATBOT_HOST: {{ compose.web.chatbot_host | to_json }}
      DB_USER: {{ compose.database.user | to_json }}
      DB_PASSWD: {{ compose.secrets.database_password | to_json }}
      DB_NAME: {{ compose.database.name | to_json }}
      DB_HOST: database-server
      VAULT_URL: http://vault-server:5002
    volumes:
      - {{ (compose.web.evaluation_config + ':/data/config/evaluation_system.conf:ro,Z') | to_json }}
      - {{ (compose.web.web_config + ':/data/config/freva_web.toml:ro,Z') | to_json }}
      - web-static:/opt/freva_web/static:z
      - web-logs:/data/logs:z
    depends_on:
      database-server:
        condition: service_healthy
      vault-server:
        condition: service_healthy
      freva-rest-server:
        condition: service_healthy
{% if not compose.web.reverse_proxy %}
    ports:
      - {{ (compose.ports.web | string + ':8000') | to_json }}
{% endif %}

{% if compose.web.reverse_proxy %}
  web-reverse-proxy:
    image: {{ compose.images.proxy | to_json }}
    environment:
      SERVER_ROOT: /srv/static
      VAULT_HOST: vault-server:5002
      FREVA_REST_HOST: freva-rest-server:7777
      CHATBOT_HOST: {{ compose.web.chatbot_host | to_json }}
      WEB_SERVER_NAME: web-app
      WEB_SERVER_PORT: "8000"
      REST_PROXY_HOST_NAME: {{ compose.external_url | to_json }}
      FILL_COLOR: {{ compose.web.main_color | to_json }}
      PROXY_USER: nobody
      PROJECT_NAME: {{ compose.project_name | to_json }}
      PORT_HTTPD: "8080"
      PORT_HTTPSD: "8443"
      NO_HTTP_CERT: "1"
      WEB_HOST: {{ compose.web.external_host | to_json }}
    ports:
      - {{ (compose.ports.http | string + ':8080') | to_json }}
      - {{ (compose.ports.https | string + ':8443') | to_json }}
    volumes:
      - web-static:/srv/static:z
      - proxy-logs:/data/logs:z
    depends_on:
      - web-app
{% endif %}
{% endif %}

volumes:
  cache-data:
  cache-logs:
  db-data:
  db-logs:
  mongo-data:
  mongo-logs:
  rest-logs:
  solr-data:
  solr-logs:
  vault-data:
{% if compose.web.enabled %}
  web-static:
  web-logs:
{% if compose.web.reverse_proxy %}
  proxy-logs:
{% endif %}
{% endif %}
